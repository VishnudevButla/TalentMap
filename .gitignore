# ==============================================================================
# Logs
# ==============================================================================
logs/
*.log

# ==============================================================================
# Python
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Distribution / packaging
build/
dist/
eggs/
parts/
var/
sdist/
develop-eggs/
.eggs/
lib/
lib64/
*.egg-info/
*.egg
MANIFEST

# ==============================================================================
# Virtual Environments
# ==============================================================================
venv/
env/
ENV/
.venv/
.env/
Pipfile.lock

# ==============================================================================
# Django
# ==============================================================================
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Media and generated files
# NOTE: /static/ is intentionally NOT ignored here — in this FastAPI app,
# static/ is real source code (css/js), not a build output. An earlier,
# generic Django-template line ignored it by mistake, which meant every
# stylesheet and script had silently never been committed to this repo.
/media/
/staticfiles/

# Django secret key / environment variables
.env
.env.*
!.env.example

# ==============================================================================
