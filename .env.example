# TalentMap — environment template. Copy this file to `.env` and fill in
# real values. `.env` itself is gitignored on purpose (it holds real
# credentials) — this file is the only thing that travels with the repo.

# ==========================
# MongoDB (required)
# ==========================
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Full Atlas connection string, credentials included.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=TalentMap
appName=TalentMap

# ==========================
# AWS S3 (required — resume file storage)
# ==========================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# ==========================
# JWT (required)
# ==========================
# Generate your own random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ==========================
# Job API (required — powers real job postings)
# ==========================
JOB_API_PROVIDER=adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_BASE_URL=https://api.adzuna.com/v1/api
# RemoteOK needs no key.
REMOTEOK_BASE_URL=https://remoteok.com/api

# ==========================
# Groq (required — resume NER/entity extraction)
# ==========================
GROQ_API_KEY=

# ==========================
# Email — Brevo (optional; leave EMAIL_ENABLED=False to skip)
# ==========================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TalentMap Alerts

EMAIL_ENABLED=False
EMAIL_PROVIDER=brevo
EMAIL_FALLBACK_ENABLED=True

# SMTP fallback (optional, only used if the Brevo API call fails)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# ==========================
# AI Job Agent scheduler (required to run worker.py)
# ==========================
# Must be True for the background worker to actually scan/match/email —
# see worker.py.
AGENT_SCHEDULER_ENABLED=True
AGENT_SCAN_INTERVAL_MINUTES=360
AGENT_MAX_SOURCES_PER_SCAN=3
JOB_RETENTION_DAYS=7
EMAIL_DIGEST_HOUR=9

# ==========================
# Google OAuth (optional — "Continue with Google" on login/register)
# ==========================
# From Google Cloud Console → APIs & Services → Credentials → an OAuth
# 2.0 Client ID (Web application type). Authorized redirect URI must be
# exactly APP_BASE_URL + /api/auth/google/callback, e.g. for local dev:
#   http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
